%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_sec_trainer — the guardian's trainer
%% (mcl-sec-guard#20), net-free since mcl-sec-guard#14: the faber
%% dependency moved to mcl_sec_trainer_learner, so this app's closure
%% is kernel+stdlib only — which is what lets it enter the release
%% (mcl-sec-guard#16) without dragging faber (and mnesia) in. The file
%% stays as the place the split is documented.
%%
%% Build with FABER_TWEANN_SKIP_NIF=1 in the environment (CI's
%% lint-and-test sets it): the learner app's optional Rust NIFs are
%% skipped and it selects the pure fallback at first use.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.
