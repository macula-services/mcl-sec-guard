%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_sec_trainer — the guardian's trainer
%% (PLAN_AUTONOMOUS_GUARDIAN.md). The first app in this umbrella with
%% its own config: faber_tweann is a dependency of THIS application
%% only, so the service application's closure stays lean, and the
%% trainer stays out of the root relx release list.
%%
%% Build with FABER_TWEANN_SKIP_NIF=1 in the environment (CI's
%% lint-and-test sets it; the kick-off exports it): the package's
%% optional Rust NIFs are skipped, and the learner selects the pure
%% fallback at first use — everything this trainer uses is pure Erlang.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The learner arm (step 4): sep_cma_es and the activation
    %% functions.
    {faber_tweann, "~> 2.4"}
]}.
