{application, mcl_sec_trainer, [
    {description, "The guardian's trainer: the simulator world, scenarios and learner arm (not a service, not a library app)"},
    {vsn, "0.2.0"},
    {registered, [mcl_sec_trainer_sup]},
    {mod, {mcl_sec_trainer_app, []}},
    {applications, [
        kernel,
        stdlib
    ]},
    {env, [
        %% Off by default: in-service training children (the learner arm)
        %% start only when this is true. The pure sim, scenarios and
        %% fitness modules need no processes at all.
        {enabled, false}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-sec-guard"}]}
 ]}.
