{application, mcl_sec_guard, [
    {description, "The security guardian, P0 shadow: observes denial facts and records proposals; applies nothing"},
    {vsn, "0.2.0"},
    {registered, [mcl_sec_guard_sup]},
    {mod, {mcl_sec_guard_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-sec-guard"}]}
]}.
