{application, mcl_sec_trainer_learner, [
    {description, "The trainer's learner arms: sep_cma_es over the fixed shape and the TWEANN arm (faber-scoped, never in the release)"},
    {vsn, "0.2.4"},
    %% A code container (no `mod', no supervisor): nothing starts it,
    %% and it never enters the release. faber_tweann, its only
    %% dependency, is declared in this app's own rebar.config
    %% (mcl-sec-guard#14).
    {applications, [
        kernel,
        stdlib
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-sec-guard"}]}
 ]}.
