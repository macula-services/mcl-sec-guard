%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_sec_trainer_learner — the learner arm
%% split out of mcl_sec_trainer so faber_tweann scopes to this app only
%% (mcl-sec-guard#14). The trainer app carries no faber dep; this app is
%% a code container (no `mod') and never enters the release: the learner
%% stays a dev-box act. Successors that need the learner take it as a
%% dep of their own (the kick-off shell, tests, future Phase C work).
%%
%% Build with FABER_TWEANN_SKIP_NIF=1 in the environment (CI's
%% lint-and-test sets it; the kick-off exports it): the package's
%% optional Rust NIFs are skipped, and the learner selects the pure
%% fallback at first use — everything this learner uses is pure Erlang.
{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% sep_cma_es and the activation functions — the only faber
    %% dependency left in this umbrella.
    {faber_tweann, "~> 2.4"}
]}.
